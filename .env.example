COBALT_API_URL=https://your-cobalt-server.example.com/
COBALT_API_KEY=
SHORTCUT_API_KEY=

# optional | required. Keep optional so the public website works without a key.
SHORTCUT_AUTH_MODE=optional

# Optional YouTube fallback for hosts where Cobalt's YouTube streams are blocked.
# Install yt-dlp and FFmpeg, then set their absolute executable paths.
YTDLP_PATH=
FFMPEG_PATH=

# Optional canonical public origin, for example https://downloader.example.com
APP_BASE_URL=
